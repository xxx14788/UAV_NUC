<launch>
  <arg name="drone_id" default="0"/>
  <arg name="depth_fx" default="387.50775146484375"/>
  <arg name="depth_fy" default="387.50775146484375"/>
  <arg name="depth_cx" default="323.50140380859375"/>
  <arg name="depth_cy" default="232.6917266845703"/>
  <include file="$(find ego_planner)/launch/advanced_param_sitl.xml">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="map_size_x_" value="30.0"/>
    <arg name="map_size_y_" value="30.0"/>
    <arg name="map_size_z_" value="3.0"/>
    <arg name="odometry_topic" value="/vins_estimator/imu_propagate"/>
    <arg name="obj_num_set" value="10"/>
    <arg name="camera_pose_topic" value="/planner/camera_pose"/>
    <arg name="depth_topic" value="/camera/depth/image_rect_raw"/>
    <arg name="cloud_topic" value="nouse2"/>
    <arg name="cx" value="$(arg depth_cx)"/>
    <arg name="cy" value="$(arg depth_cy)"/>
    <arg name="fx" value="$(arg depth_fx)"/>
    <arg name="fy" value="$(arg depth_fy)"/>
    <arg name="max_vel" value="0.25"/>
    <arg name="max_acc" value="1.0"/>
    <arg name="planning_horizon" value="4.0"/>
    <arg name="use_distinctive_trajs" value="false"/>
    <arg name="flight_type" value="1"/>
    <arg name="point_num" value="1"/>
    <arg name="point0_x" value="0.0"/><arg name="point0_y" value="0.0"/><arg name="point0_z" value="0.5"/>
    <arg name="point1_x" value="0.0"/><arg name="point1_y" value="0.0"/><arg name="point1_z" value="0.5"/>
    <arg name="point2_x" value="0.0"/><arg name="point2_y" value="0.0"/><arg name="point2_z" value="0.5"/>
    <arg name="point3_x" value="0.0"/><arg name="point3_y" value="0.0"/><arg name="point3_z" value="0.5"/>
    <arg name="point4_x" value="0.0"/><arg name="point4_y" value="0.0"/><arg name="point4_z" value="0.5"/>
  </include>

  <!-- Advanced SITL params assume odometry input. This planner consumes T_world_cam directly. -->
  <param name="/drone_0_ego_planner_node/grid_map/pose_type" value="1"/>
  <param name="/drone_0_ego_planner_node/grid_map/ground_height" value="-0.30"/>
  <param name="/drone_0_ego_planner_node/fsm/manual_goal_z" value="0.7"/>  <!-- 2026-11-07: 与 px4ctrl takeoff_height 对齐(0.5->0.7) -->
  <param name="/drone_0_ego_planner_node/fsm/manual_goal_max_distance" value="3.5"/>  <!-- 2026-11-07 用户令：2.0 -> 3.5 -->
  <param name="/drone_0_ego_planner_node/fsm/manual_goal_use_msg_z" value="true"/>
  <param name="/drone_0_traj_server/traj_server/odom_topic" value="/vins_estimator/imu_propagate"/>
  <param name="/drone_0_traj_server/traj_server/time_forward" value="1.0"/>
  <remap from="/move_base_simple/goal" to="/flight_v1/goal_gate"/>
  <node pkg="ego_planner" name="drone_0_traj_server" type="traj_server" output="screen">
    <remap from="~planning/bspline" to="/drone_0_planning/bspline"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
    <param name="traj_server/odom_topic" value="/vins_estimator/imu_propagate"/>
  </node>
</launch>
