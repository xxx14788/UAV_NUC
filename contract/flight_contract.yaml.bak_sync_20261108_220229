# flight_v1 接缝契约（方案 v2，2026-11-08）
# 唯一事实源：谁必须等于谁、每条边的活性下限。改动此文件后必须同步：
#   - run_planner_realmachine_map_v1.launch（depth_topic / camera_pose_topic / goal_topic /
#     fsm/manual_goal_z / fsm/manual_goal_max_distance）
#   - ~/realflight_stack.sh 的深度健康门（读本文件，无需改）
#   - flight_mission.py 的 GOAL_RADIUS 回退常量（读本文件，仅作缺省）
# 校验：python3 check_interfaces.py --task（起飞前硬门，flight_mission preflight 会跑）
version: 1

seams:
  depth:
    topic: /camera/depth/image_rect_raw      # 规划器 grid_map/depth 的实际输入
    type: sensor_msgs/Image
    min_hz: 10.0
    consumers: [drone_0_ego_planner_node]
  camera_pose:
    topic: /planner/camera_pose              # grid_map/pose 的实际输入
    type: geometry_msgs/PoseStamped
    min_hz: 8.0
    # 与 depth 的 header.stamp 中位差上限。**这不是延迟检查**，只用来抓"时钟基不同"
    # （真故障是秒~小时级）。延迟/断流由上面的 min_hz 活性检查兜底（事故形态是 1.885 s
    # 停发，3 s 窗内平均会掉到 ~5.5 Hz < 8 -> FAIL）。取 5 s 是为了不被假传感器/缓冲拖累。
    max_skew_s: 5.0
    source: /vins_estimator/camera_pose      # 上游（VINS 转发）
    publisher: /planner_camera_pose_relay
  goal:
    topic: /flight_v1/goal_gate
    rviz_topic: /move_base_simple/goal       # 仅供任务脚本校验后转发，规划器禁止直连
    consumer: drone_0_ego_planner_node
  command:
    topic: /position_cmd
    min_hz: 20.0
    publisher: /drone_0_traj_server

params:
  takeoff_height: 0.70          # == px4ctrl takeoff_height == 规划器 manual_goal_z
  goal_radius_m: 3.5            # == 规划器 manual_goal_max_distance == mission GOAL_RADIUS
  takeoff_hover_s: 5.0
  goal_hover_s: 5.0
  max_vel: 0.5
  max_acc: 6.0
  pose_type: 1
  resolution: 0.15
  obstacles_inflation: 0.337
  max_ray_length: 2.5
  local_map_margin: 10
  ground_height: -0.10
  map_size_z: 1.60             # 天花板 = 1.50
  ceiling_max: 1.5
  depth_mindist: 0.200          # 近场剔除下限（显式；几何门: mindist+cam_fwd <= eff_inflation）
  self_bubble: 0.450            # 自机气泡半径（bspline 与 A* 共用；缺省=等效膨胀）

runtime:
  # 2026-11-08：以下三组原来散落在 launch / bash / 人的操作卡里，现已收到契约。
  depth_intrinsics:            # 规划器消费的 D435 对齐深度内参（VINS 用它自己的一套，见 left/right yaml）
    fx: 387.507751
    fy: 387.507751
    cx: 323.501404
    cy: 232.691727
  rc:
    channels: 8
    centered_tol: 125
    ch5_min: 1750
  battery:
    min_fly_v: 14.0             # 人操作卡的"才许飞"门（mission preflight 用的是这个）
    low_voltage_v: 13.2         # px4ctrl 的掉电保护（低于它才保护，与上式不同层）
health_gate:
  depth_topic: /camera/depth/image_rect_raw      # 必须 == seams.depth.topic
  min_hz: 15.0

record_topics:   # 录包唯一清单（recorder 读 generated/record_topics.txt）
  - /mavros/state
  - /mavros/extended_state
  - /mavros/battery
  - /mavros/imu/data
  - /mavros/imu/data_raw
  - /mavros/imu/mag
  - /mavros/imu/temperature_imu
  - /mavros/local_position/odom
  - /mavros/vision_pose/pose
  - /mavros/rc/in
  - /mavros/rc/out
  - /mavros/setpoint_raw/attitude
  - /mavros/time_reference
  - /mavros/estimator_status
  - /camera/infra1/image_rect_raw
  - /camera/infra1/camera_info
  - /camera/infra2/image_rect_raw
  - /camera/infra2/camera_info
  - /camera/depth/image_rect_raw
  - /camera/depth/camera_info
  - /vins_estimator/odometry
  - /vins_estimator/imu_propagate
  - /vins_estimator/camera_pose
  - /vins_estimator/extrinsic
  - /vins_estimator/keyframe_pose
  - /px4ctrl/takeoff_land
  - /debugPx4ctrl
  - /debugPx4ctrl/fsm_state
  - /move_base_simple/goal
  - /flight_v1/goal_gate
  - /position_cmd
  - /drone_0_planning/bspline
  - /flight_v1/planned_path
  - /flight_v1/executed_trail
  - /flight_v1/goal_marker
  - /tf
  - /tf_static
  - /rosout
