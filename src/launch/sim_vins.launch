<launch>
    <!-- T2b-U6 (2026-09-28): sim 时钟域配方固化。/use_sim_time 必须在
         mavros 启动前置真(mavros IMU 戳随启动时刻的参数定域; 之后翻面会造成
         gazebo 相机戳=sim 域与 mavros IMU 戳=unix 域分家 1.79e9s, VINS 永无法
         对齐且 dt=1.79e9 毒化传播——W5 220 次门控拒绝与 U1 毒槽位的实测根因)。
         本 launch 置真仅保证 vins/vins_to_mavros 域; mavros 由 02_start_mavros.sh
         更早置真, 勿在两者之间翻面。结构性防线: domain_guard.py + preflight。 -->
    <param name="/use_sim_time" value="true"/>
    <!-- A7 仿真 VINS 入口：VINS-Fusion 双目+IMU 里程计 + vins_to_mavros 转发。
         前置：iris_stereo_vins 模型 SITL 已启动（start_sitl_vins.sh），
               mavros 已启动，且已执行 mavcmd long 511 105 4000（IMU 提频，
               5000 会因 lockstep 4ms 网格量化锁死 125Hz，4000 对齐网格实测 ~223Hz，2026-09-28 探针定案）。
         输出：/vins_estimator/imu_propagate（高频里程计，供 planner/px4ctrl）
               /vins_estimator/odometry（供 vins_to_mavros）
               /mavros/vision_pose/pose（喂 PX4 EKF2，照实机链路）
         消费：run_planner_sitl_vins.launch / run_ctrl_sitl_vins.launch -->
    <node pkg="vins" type="vins_node" name="vins_estimator" output="screen"
          args="$(env HOME)/catkin_ws/src/VINS-Fusion/config/sim_stereo/sim_stereo_imu_config.yaml"/>
    <node name="vins_to_mavros" pkg="vins_to_mavros" type="vins_to_mavros_node" output="screen">
        <!-- T1 E-5a: publish arm via env (default pose = legacy bit-path; T1_E5A_PUB_MODE=odom for L-odom arm) -->
        <param name="pub_mode" value="$(optenv T1_E5A_PUB_MODE pose)"/>
    </node>
</launch>
