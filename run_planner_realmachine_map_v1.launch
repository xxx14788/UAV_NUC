<launch>
  <arg name="drone_id" default="0"/>
  <arg name="depth_fx" default="387.50775146484375"/>
  <arg name="depth_fy" default="387.50775146484375"/>
  <arg name="depth_cx" default="323.50140380859375"/>
  <arg name="depth_cy" default="232.6917266845703"/>
  <include file="$(find ego_planner)/launch/advanced_param_sitl.xml">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="map_size_x_" value="30.0"/>
    <arg name="map_size_y_" value="30.0"/>
    <!-- 2026-11-07（用户令：禁止从箱子上方飞越）：map_size_z 就是**天花板**。
         grid_map.h:327 getInflateOccupancy(): 越界 return -1，调用点当 bool 用 -> -1 为真 -> 越界=占据=撞。
         所以地图顶 = 地面(-0.01) + map_size_z。
         箱子高 1.5 m，取 map_size_z=1.51 -> 顶 1.30 m < 1.5 -> 箱顶以上在图上不存在 -> 规划器不可能从上面过。
         飞行高度 0.7 m，头顶留 0.60 m 余量。
         （原来的 3.0 会让地图顶到 2.70 m，规划器可以合法地从 1.5 m 箱子上方绕过去。） -->
    <arg name="map_size_z_" value="1.51"/>
    <arg name="odometry_topic" value="/vins_estimator/imu_propagate"/>
    <arg name="obj_num_set" value="10"/>
    <arg name="camera_pose_topic" value="/planner/camera_pose"/>
    <arg name="depth_topic" value="/camera/depth/image_rect_raw"/>
    <arg name="cloud_topic" value="nouse2"/>
    <!-- 2026-11-07 审查修正（D7）：目标点走校验门。
         flight_mission.py 把校验过的目标发到 /flight_v1/goal_gate；
         这里让规划器**只**听这个话题，RViz 原始目标（以及 mavros guided_target）
         就不会绕过校验直达规划器。 -->
    <arg name="goal_topic" value="/flight_v1/goal_gate"/>
    <arg name="cx" value="$(arg depth_cx)"/>
    <arg name="cy" value="$(arg depth_cy)"/>
    <arg name="fx" value="$(arg depth_fx)"/>
    <arg name="fy" value="$(arg depth_fy)"/>
    <arg name="max_vel" value="0.5"/>
    <arg name="max_acc" value="1.0"/>
    <arg name="planning_horizon" value="4.0"/>
    <arg name="use_distinctive_trajs" value="false"/>
    <arg name="flight_type" value="1"/>
    <arg name="point_num" value="1"/>
    <arg name="point0_x" value="0.0"/><arg name="point0_y" value="0.0"/><arg name="point0_z" value="0.5"/>
    <arg name="point1_x" value="0.0"/><arg name="point1_y" value="0.0"/><arg name="point1_z" value="0.5"/>
    <arg name="point2_x" value="0.0"/><arg name="point2_y" value="0.0"/><arg name="point2_z" value="0.5"/>
    <arg name="point3_x" value="0.0"/><arg name="point3_y" value="0.0"/><arg name="point3_z" value="0.5"/>
    <arg name="point4_x" value="0.0"/><arg name="point4_y" value="0.0"/><arg name="point4_z" value="0.5"/>
  </include>

  <!-- 2026-11-07（安全修复）：实机必须用实机膨胀值。
       advanced_param_sitl.xml 里是 0.299（仿真值，理由"仿真机体无云台杆遮挡"），
       实机标定值是 0.337（见 advanced_param_exp.xml:96 与 sitl 文件头注释）。
       且 grid_map.cpp:604 是  —— **整格施加**：
         0.299 -> ceil(1.993)=2 格 -> 实际膨胀 0.30 m（实机在用的）
         0.337 -> ceil(2.247)=3 格 -> 实际膨胀 0.45 m（正确值）
       即实机每边少 15 cm 余量。这里覆盖回实机值。 -->
  <!-- Advanced SITL params assume odometry input. This planner consumes T_world_cam directly. -->
  <!-- 2026-11-07 审查修正（D9，离线台子实测）：原来 ground_height=-0.30，
       而箱子坐在地面 z=0 上 -> 地图在 -0.30~0 留了一条 0.3m 的"地下走廊"，
       规划器真的从箱子**下面**钻过去（实测 z 掉到 -0.25，水平余量 -0.43m = 撞）。
       改成 ground_height=0.0（地板贴地）+ map_size_z=1.3（天花板仍 1.30m < 箱高 1.5m）。
       实测轨迹 z 恒 0.700，余量 +0.128m。 -->
    <!-- 2026-11-08（今早四袋判读）：-0.30 让**真实地板**落进地图（地板点在 z~0，
       map 底 -0.30 -> 地板被当障碍 + 0.45m 膨胀 -> 规划器报 "drone is in obstacle"
       并拒绝规划，实测发目标后 /position_cmd 0 条）。抬到 0.05 = 略高于地面，
       地板近场点(7~22cm)直接落到图外。map_size_z 1.25 -> 天花板仍 1.30 < 箱高 1.5。 -->
  <!-- 近场剔除：机体/桨/地板在相机 0.1~0.3 m 内的点不要进图 -->
  <!-- 2026-11-08（独立审计）：0.35 -> 0.2。
       盲面 = mindist + 相机前移 0.034；0.35 时 0.384 m，而膨胀实际 0.45 m（ceil(0.337/0.15)=3 格），
       余量再被 0.15 m 体素吃掉 = 零 -> "0.25~0.38 m 的真障碍看不见又被当可通行"。
       0.2 时盲面 0.234 m、余量 0.216 m；近场自机点实测 7~22 cm 仍被剔除（0.2 足够）。 -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <!-- ===== 2026-11-08 user-order items: derived params; primitives live in
       ~/sitl_realmachine/flight_v1/sync_params.py (change one, all follow) =====
       primitives: resolution 0.15 / obstacles_inflation 0.15 / ground_height -0.01 / ceiling_max 1.50 / max_ray_length 2.5
       derived: map_size_z = 1.51 -> ceiling 1.50 ; eff_inflation = ceil(0.15/0.15)*0.15 = 0.15 ; depth_mindist = 0.115 (blind 0.149 <= inflation 0.15) -->
  <param name="/drone_0_ego_planner_node/grid_map/obstacles_inflation" value="0.15"/>
  <param name="/drone_0_ego_planner_node/grid_map/ground_height" value="-0.01"/>
  <param name="/drone_0_ego_planner_node/grid_map/map_size_z" value="1.51"/>
  <param name="/drone_0_ego_planner_node/grid_map/max_ray_length" value="2.5"/>
  <param name="/drone_0_ego_planner_node/grid_map/depth_filter_maxdist" value="5.0"/>
  <param name="/drone_0_ego_planner_node/grid_map/depth_filter_mindist" value="0.115"/>
  <param name="/drone_0_ego_planner_node/grid_map/pose_type" value="1"/>
  <param name="/drone_0_ego_planner_node/grid_map/local_map_margin" value="10"/>
  <param name="/drone_0_ego_planner_node/fsm/manual_goal_z" value="0.7"/>  <!-- 2026-11-07: 与 px4ctrl takeoff_height 对齐(0.5->0.7) -->
  <param name="/drone_0_ego_planner_node/fsm/manual_goal_max_distance" value="3.5"/>  <!-- 2026-11-07 用户令：2.0 -> 3.5 -->
  <!-- 2026-11-07 审查修正：原为 true -> 目标高度取自 RViz 消息 z。
         RViz 2D Nav Goal 在地面平面打点，发出的 z=0 -> 飞机会被命令降到地面。
         守卫只有 z<-0.1 才拒，z=0 放行。改为 false -> 恒用 manual_goal_z=0.7。 -->
  <param name="/drone_0_ego_planner_node/fsm/manual_goal_use_msg_z" value="false"/>
  <!-- 2026-11-08（方案 v2 P2）：急停自愈开关与健康确认窗。false / 大值 = 回到旧行为。 -->
  <param name="/drone_0_ego_planner_node/fsm/fail_safe_recover" value="true"/>
  <param name="/drone_0_ego_planner_node/fsm/fail_safe_recover_hold_s" value="2.5"/>
  <param name="/drone_0_traj_server/traj_server/odom_topic" value="/vins_estimator/imu_propagate"/>
  <param name="/drone_0_traj_server/traj_server/time_forward" value="1.0"/>
  <!-- 2026-11-07 审查修正（D7）：原来的顶层 remap 写在这里是**无效的**——
       roslaunch 顶层 <remap> 不作用于 <include> 内的节点，实测规划器仍在听
       /move_base_simple/goal、/flight_v1/goal_gate 根本不存在。
       现在改成通过 include 的 goal_topic 参数传下去（见上方 arg）。 -->
  <node pkg="ego_planner" name="drone_0_traj_server" type="traj_server" output="screen">
    <remap from="~planning/bspline" to="/drone_0_planning/bspline"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
    <param name="traj_server/odom_topic" value="/vins_estimator/imu_propagate"/>
  </node>
</launch>
