<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <magnetic_field>6.0e-5 0 0</magnetic_field> <!-- T1-W3: 磁北水平分量对齐世界 +X(spawn RPY=0 → yaw=0)。默认值是 gazebo 内建北加州地磁(5.49145e-6 1.33514e-5 -6.05885e-6),水平指向 +Y 侧 67.7°,经 ENU→NED 映射后 spawn yaw≈-90°(2026-09-27 实测 quat z≈-0.703)。若 w3_yaw_check 实测为 ±90/180°,按结果翻转到对应轴。 -->
    <!-- 避障测试 world（A5）：empty.world 底 + 3 个静态箱型障碍。
         坐标系换算：EKF2 odom 原点 = 机体 spawn 点 gazebo(1.01, 0.98)，
         故 gazebo_xy = odom_xy + (1.01, 0.98)。分析脚本一律用下表 odom 坐标。
         +---------+----------------+-------------+------------------+------------------+
         | 障碍     | odom (x, y)    | 尺寸 x*y*z  | gazebo (x, y)    | 用途              |
         +---------+----------------+-------------+------------------+------------------+
         | box_A   | (3.5, -1.5)    | 1.0*1.0*1.8 | (4.51, -0.52)   | 起飞->goal 主路径 |
         | box_B   | (5.0, -2.5)    | 1.5*1.0*1.2 | (6.01, -1.52)   | 主路径，需绕行    |
         | box_C   | (4.5, -3.5)    | 1.0*1.0*2.2 | (5.51, -2.52)   | goal 侧翼         |
         +---------+----------------+-------------+------------------+------------------+
         参考 goal（odom）：(7.0, -4.0, 1.0)，直线穿障碍区。 -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://asphalt_plane</uri>
    </include>
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <model name="box_A">
      <pose>4.51 -0.52 0.9 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.8</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_B">
      <pose>6.01 -1.52 0.6 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.0 1.2</size></box></geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_C">
      <pose>5.51 -2.52 1.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 2.2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
