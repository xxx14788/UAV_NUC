<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- sitl_world_corridor.world — ③C 避障代表性整改（2026-10-13 单阶段高质量制）
    设计正源: world_design_rationale.md（EGO 参数推导链）+ plans 2026-10-13_专项③C 任务书单元1.1
    结构: plain 同底(sun+ground_plane+asphalt_plane+physics/scene 逐字节同源) +
          双走廊展示 7 箱(主 E x4 + 副 NE x3, 1×1×1.8, z 心 0.9, 沿走廊均布 2.5m, 中线错列 ±0.20m 成 S 绕行)
          + 彩板 30 块(plain 特征密度配方, 供给面) + 箱面强纹理(Wood/Bricks 交替)
    主走廊: spawn(1.01,0.98)->goal(13.01,0.98) 同 E12O 口径; 箱 cB1-cB4 gazebo x=3.01/5.51/8.01/10.51
    副走廊: spawn(1.01,0.98)->goal(9.50,9.47) 同 NE12O 口径; 箱 cN1-cN3 沿对角线 s=3.5/6.0/8.5
    坐标换算: gazebo_xy = odom_xy + (1.01, 0.98)（同 plain/obstacles 口径）
    场景门: round_result.sh v1.5 起 corridor 含障碍 → 到位门 0.75（任务书单元3 预注册） -->

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://asphalt_plane</uri></include>
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>

    <model name="cB1">
      <pose>5.463 1.767 0.9 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.8</size></box></geometry>
          <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri><uri>file://media/materials/textures</uri></script></material>
        </visual>
      </link>
    </model>

    <model name="cB2">
      <pose>8.024 1.057 0.9 0 0 0</pose>
      <static>true</static>
      <link name="link">
