<!-- UAV_NUC v0.2: measured-airframe model derived from PX4 v1.17 Iris. -->
<sdf version='1.6'>
  <model name='uav_nuc'>
    <!-- The model origin is the flight-controller IMU. Lift it 0.215 m so the
         measured landing contacts start on the ground when spawned at z=0. -->
    <pose>0 0 0.215 0 0 0</pose>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Total model mass closes to 2.305 kg after IMU (0.015), four
             rotors (4x0.005) and GPS (0.015) are included. CG is 30 mm
             below the IMU in FRD, i.e. z=-0.030 in Gazebo FLU. -->
        <pose>0 0 -0.030 0 0 0</pose>
        <mass>2.255</mass>
        <inertia>
          <!-- First-order geometric estimate; replace after identification. -->
          <ixx>0.0155</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0155</iyy>
          <iyz>0</iyz>
          <izz>0.0270</izz>
        </inertia>
      </inertial>
      <!-- Battery + centre-frame combined collision: measured 137x115x135 mm,
           bottom at ground z=0.095 and top at z=0.230. -->
      <collision name='body_battery_collision'>
        <pose>0 0 -0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.137 0.115 0.135</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <!-- Four vertical landing legs directly below the measured motor centres.
           Each leg runs from propeller-centre height z=+5 mm to the ground
           plane z=-215 mm in the IMU-centred model frame. -->
      <collision name='landing_front_right_collision'>
        <pose>0.11744 -0.11744 -0.105 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry>
      </collision>
      <collision name='landing_front_left_collision'>
        <pose>0.11744 0.11744 -0.105 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry>
      </collision>
      <collision name='landing_back_right_collision'>
        <pose>-0.11744 -0.11744 -0.105 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry>
      </collision>
      <collision name='landing_back_left_collision'>
        <pose>-0.11744 0.11744 -0.105 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry>
      </collision>

      <visual name='centre_frame_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.115 0.115 0.030</size></box>
        </geometry>
        <material>
          <ambient>0.025 0.025 0.025 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse>
        </material>
      </visual>
      <visual name='battery_visual'>
        <!-- Battery top z=-15 mm touches the centre-frame bottom. -->
        <pose>0 0 -0.0365 0 0 0</pose>
        <geometry><box><size>0.137 0.043 0.043</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
      <visual name='nuc_visual'>
        <pose>0 0 0.030 0 0 0</pose>
        <geometry><box><size>0.112 0.112 0.034</size></box></geometry>
        <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.025 0.025 0.025 1</diffuse></material>
      </visual>
      <!-- D435 housing. Geometric centre is z=+0.0585 FLU; sensor reference
           is z=+0.065. Dimensions come from realsense2_description. -->
      <visual name='d435_housing_visual'>
        <pose>0.040 0 0.0585 0 0 0</pose>
        <geometry><box><size>0.02505 0.090 0.025</size></box></geometry>
        <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
      </visual>
      <visual name='d435_front_visual'>
        <pose>0.053 0 0.0585 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
      </visual>
      <!-- Motor radius 166.09 mm: 20 mm prop-tip clearance from the 115 mm core. -->
      <visual name='arm_front_right_visual'><pose>0.05872 -0.05872 -0.015 0 0 -0.785398</pose><geometry><box><size>0.16609 0.016 0.012</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name='arm_front_left_visual'><pose>0.05872 0.05872 -0.015 0 0 0.785398</pose><geometry><box><size>0.16609 0.016 0.012</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name='arm_back_right_visual'><pose>-0.05872 -0.05872 -0.015 0 0 0.785398</pose><geometry><box><size>0.16609 0.016 0.012</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name='arm_back_left_visual'><pose>-0.05872 0.05872 -0.015 0 0 -0.785398</pose><geometry><box><size>0.16609 0.016 0.012</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name='landing_front_right_visual'><pose>0.11744 -0.11744 -0.105 0 0 0</pose><geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <visual name='landing_front_left_visual'><pose>0.11744 0.11744 -0.105 0 0 0</pose><geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <visual name='landing_back_right_visual'><pose>-0.11744 -0.11744 -0.105 0 0 0</pose><geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <visual name='landing_back_left_visual'><pose>-0.11744 0.11744 -0.105 0 0 0</pose><geometry><cylinder><radius>0.006</radius><length>0.220</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <gravity>1</gravity>
